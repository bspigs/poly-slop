# Research provider: auto, openai, or ollama.
# auto uses OpenAI when OPENAI_API_KEY exists; otherwise it uses local Ollama.
RESEARCH_PROVIDER=auto

# Optional OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Local keyless Ollama provider.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
RESEARCH_TIMEOUT=180

# Scanner / risk settings
MAX_MARKETS=30
MIN_LIQUIDITY=25000
MIN_VOLUME=10000
MIN_MARKET_PRICE=0.08
MAX_MARKET_PRICE=0.92
MIN_DAYS_TO_RESOLUTION=0
MAX_DAYS_TO_RESOLUTION=7
MIN_EDGE=0.08
MIN_CONFIDENCE=0.60
MAX_POSITION_PCT=0.01
BASELINE_POSITION_PCT=0.0025
STARTING_BANKROLL=10000

# BTC 15-minute scalp simulator
# P&L is calculated from CLOB ask entry -> CLOB bid exit and subtracts
# estimated taker fees on both legs. Repeated sequential trades are allowed.
# Take-profit and stop-loss are NET dollars on the simulated position.
BTC_SCALP_POLL_SECONDS=2
BTC_SCALP_TAKE_PROFIT_USD=0.05
BTC_SCALP_TRAIL_ARM_USD=0.04
BTC_SCALP_TRAIL_GIVEBACK_USD=0.02
BTC_SCALP_STOP_LOSS_USD=0.75
BTC_SCALP_STOP_GRACE_SECONDS=45
BTC_SCALP_FORCE_EXIT_SECONDS=20
BTC_SCALP_MIN_ENTRY_SECONDS=30
BTC_CLOB_WAIT_SECONDS=20
BTC_CRYPTO_TAKER_FEE_RATE=0.07
