# Research provider: auto, openai, or ollama.
# auto uses OpenAI when OPENAI_API_KEY exists; otherwise it uses local Ollama.
RESEARCH_PROVIDER=auto

# Optional OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Local keyless Ollama provider. Used by the general market scanner, not BTC v2 direction.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
RESEARCH_TIMEOUT=180

# Scanner / risk settings
MAX_MARKETS=30
MIN_LIQUIDITY=25000
MIN_VOLUME=10000
MIN_MARKET_PRICE=0.08
MAX_MARKET_PRICE=0.92
MIN_DAYS_TO_RESOLUTION=0
MAX_DAYS_TO_RESOLUTION=7
MIN_EDGE=0.08
MIN_CONFIDENCE=0.60
MAX_POSITION_PCT=0.01
BASELINE_POSITION_PCT=0.0025
STARTING_BANKROLL=10000

# BTC 15-minute paper scalp execution - one-second tick profile
BTC_SCALP_POLL_SECONDS=1
BTC_SCALP_TAKE_PROFIT_USD=0.05
BTC_SCALP_TRAIL_ARM_USD=0.04
BTC_SCALP_TRAIL_GIVEBACK_USD=0.02
BTC_SCALP_STOP_LOSS_USD=0.75
BTC_SCALP_STOP_GRACE_SECONDS=15
BTC_SCALP_FORCE_EXIT_SECONDS=5
BTC_SCALP_MIN_ENTRY_SECONDS=8
BTC_CLOB_WAIT_SECONDS=1
BTC_CRYPTO_TAKER_FEE_RATE=0.07

# BTC v2 soft-model inputs. Momentum influences fair value but does NOT block entry.
BTC_SIGNAL_WARMUP_SECONDS=0
BTC_SIGNAL_POLL_SECONDS=1
BTC_SIGNAL_REENTRY_COOLDOWN_SECONDS=0.25
BTC_SIGNAL_MIN_MOMENTUM_BPS=0
BTC_SIGNAL_MOMENTUM_SCALE_BPS=4.0
BTC_SIGNAL_MAX_MOMENTUM_PROBABILITY_BOOST=0.04
BTC_SIGNAL_MAX_ADVERSE_ACCEL_BPS=999
BTC_SIGNAL_MIN_FAIR_PROBABILITY=0.50
BTC_SIGNAL_MIN_FEE_ADJUSTED_EDGE=-0.015
BTC_SIGNAL_MAX_SPREAD=0.10
BTC_SIGNAL_MIN_CONTRACT_PRICE=0.05
BTC_SIGNAL_MAX_CONTRACT_PRICE=0.95
BTC_SIGNAL_MIN_DEPTH_MULTIPLE=1.0
BTC_SIGNAL_REVERSAL_CHECK_AFTER_SECONDS=3
BTC_SIGNAL_REVERSAL_MIN_CONFIDENCE=0.51

# 1 Hz two-sided slip scanner.
# PAPER exploration intentionally permits a small modeled negative edge so the
# ledger captures near-breakeven dislocations rather than sitting idle forever.
BTC_TICK_MIN_FEE_ADJUSTED_EDGE=-0.015
BTC_TICK_MAX_SPREAD=0.10
BTC_TICK_MIN_CONTRACT_PRICE=0.05
BTC_TICK_MAX_CONTRACT_PRICE=0.95
BTC_TICK_MIN_DEPTH_MULTIPLE=1.0
